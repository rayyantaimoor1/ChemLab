{
  "anim_neutralisation": {
    "equation": "HCl + NaOH → NaCl + H₂O",
    "viewBox": [0, 0, 340, 190],
    "particles": [
      { "id": "h_acid", "label": "H", "element": "H", "r": 15 },
      { "id": "cl", "label": "Cl", "element": "Cl", "r": 20 },
      { "id": "na", "label": "Na", "element": "Na", "r": 19 },
      { "id": "o", "label": "O", "element": "O", "r": 19 },
      { "id": "h_base", "label": "H", "element": "H", "r": 14 }
    ],
    "steps": [
      {
        "durationMs": 1400,
        "caption": "Both are already split up in water. The acid is H⁺ and Cl⁻ ions; the alkali is Na⁺ and OH⁻ ions. Nothing is joined to anything yet.",
        "positions": {
          "h_acid": [60, 60],
          "cl": [60, 140],
          "na": [280, 140],
          "o": [270, 60],
          "h_base": [305, 42]
        },
        "charges": { "h_acid": "+", "cl": "−", "na": "+", "o": "−" },
        "bonds": [{ "from": "o", "to": "h_base", "type": "covalent" }]
      },
      {
        "durationMs": 1400,
        "caption": "Opposite charges pull together, so the H⁺ ion and the OH⁻ ion move towards each other.",
        "positions": {
          "h_acid": [120, 62],
          "cl": [58, 142],
          "na": [283, 142],
          "o": [230, 66],
          "h_base": [265, 48]
        },
        "charges": { "h_acid": "+", "cl": "−", "na": "+", "o": "−" },
        "bonds": [{ "from": "o", "to": "h_base", "type": "covalent" }]
      },
      {
        "durationMs": 1600,
        "caption": "They join. One molecule of water forms — and that is the whole reaction. The charges cancel, so the water is neutral.",
        "positions": {
          "h_acid": [145, 48],
          "cl": [55, 145],
          "na": [285, 145],
          "o": [175, 70],
          "h_base": [205, 48]
        },
        "charges": { "cl": "−", "na": "+" },
        "bonds": [
          { "from": "o", "to": "h_base", "type": "covalent" },
          { "from": "o", "to": "h_acid", "type": "covalent" }
        ]
      },
      {
        "durationMs": 1600,
        "caption": "The Na⁺ and Cl⁻ ions never took part. They stay dissolved and unchanged — that is what a spectator ion is.",
        "positions": {
          "h_acid": [145, 50],
          "cl": [45, 155],
          "na": [295, 155],
          "o": [175, 72],
          "h_base": [205, 50]
        },
        "charges": { "cl": "−", "na": "+" },
        "bonds": [
          { "from": "o", "to": "h_base", "type": "covalent" },
          { "from": "o", "to": "h_acid", "type": "covalent" }
        ]
      }
    ]
  },

